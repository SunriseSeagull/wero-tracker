{
  "name": "werotracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "npx @better-auth/cli generate --output db/schema/auth.ts --yes",
    "shadcn:update": "npx shadcn@latest init --base radix --preset nova --reinstall --force && prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "feed": "^6.0.0",
    "flag-icons": "^7.6.0",
    "json-stable-stringify": "^1.3.0",
    "lucide-react": "^1.61.0",
    "mime-types": "^3.0.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  },
  "engine": {
    "node": ">=24.0.0"
  }
}
